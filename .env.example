# === KeyCRM API ===
KEYCRM_API_KEY=your_keycrm_bearer_token_here
KEYCRM_BASE_URL=https://openapi.keycrm.app/v1
# Офіційний ліміт KeyCRM: 20 запитів/хв. Рекомендовано 18 із запасом.
KEYCRM_RATE_LIMIT_PER_MIN=18

# ID складів у KeyCRM (можна дізнатися командою: npm run discover)
KEYCRM_WAREHOUSE_KYIV_ID=1
KEYCRM_WAREHOUSE_LUTSK_ID=2

# Режим обробки колонки "Резерв" із таблиці:
# - ignore (рекомендовано): не віднімати резерв при передачі, бо KeyCRM сам рахує резерв із замовлень
# - subtract_kyiv: відняти резерв із залишків Києва (не нижче 0)
# - subtract_lutsk: відняти резерв із залишків Луцька (не нижче 0)
# - subtract_proportional: віднімати резерв спочатку з Києва, залишок резерву з Луцька
RESERVE_MODE=ignore

# === Google Sheets ===
# Варіант 1 (рекомендований для приватної таблиці): Service Account JSON
GOOGLE_SHEET_ID=your_google_spreadsheet_id
GOOGLE_SHEET_RANGE=Sheet1!A1:Z
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json
# Або JSON-рядок напряму:
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}

# Варіант 2 (якщо таблиця відкрита для читання за посиланням):
# GOOGLE_SHEET_GID=0
# Для кількох вкладок однієї таблиці перелічіть GID через кому:
# GOOGLE_SHEET_GIDS=0,123456789
# GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_ID/export?format=csv&gid=0

# === Опціонально: пряме створення/оновлення товарів у Shopify ===
# Залиште false, якщо Shopify синхронізується через вбудовану інтеграцію KeyCRM.
# Увімкніть true, якщо потрібно створювати нові картки товарів у Shopify одразу з таблиці.
SHOPIFY_ENABLED=false
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Вкажіть статичний токен (shpat_...) АБО Client ID + Client Secret (shpss_...) для авто-оновлення
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_LOCATION_KYIV_ID=
SHOPIFY_LOCATION_LUTSK_ID=
